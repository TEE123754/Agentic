{
  "$defs": {
    "ProtectionEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "allowed",
            "blocked"
          ],
          "title": "Decision",
          "type": "string"
        },
        "layer": {
          "enum": [
            "configuration",
            "action",
            "browser",
            "network",
            "cleanup"
          ],
          "title": "Layer",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "layer",
        "reason"
      ],
      "title": "ProtectionEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "target_requests": {
      "default": 0,
      "minimum": 0,
      "title": "Target Requests",
      "type": "integer"
    },
    "environment_validated": {
      "default": false,
      "title": "Environment Validated",
      "type": "boolean"
    },
    "network_boundary_validated": {
      "default": false,
      "title": "Network Boundary Validated",
      "type": "boolean"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ProtectionEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "cleanup_outcome": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Cleanup Outcome",
      "type": "string"
    },
    "boundary_scope": {
      "default": "unvalidated",
      "enum": [
        "unvalidated",
        "owned_fixture_browser_proxy"
      ],
      "title": "Boundary Scope",
      "type": "string"
    },
    "traffic_metrics": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Traffic Metrics",
      "type": "object"
    },
    "sentinel_requests": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sentinel Requests"
    },
    "sentinel_data_unchanged": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sentinel Data Unchanged"
    }
  },
  "required": [
    "events",
    "cleanup_outcome"
  ],
  "title": "ProtectionSummary",
  "type": "object"
}
{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minimum": 1,
          "title": "Candidate Id",
          "type": "integer"
        },
        "observation_id": {
          "format": "uuid",
          "title": "Observation Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "role": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "visible": {
          "title": "Visible",
          "type": "boolean"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "bounds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "observation_id",
        "target_id",
        "role",
        "name",
        "visible",
        "enabled",
        "bounds"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CoordinateSpace": {
      "additionalProperties": false,
      "properties": {
        "offset_x": {
          "title": "Offset X",
          "type": "number"
        },
        "offset_y": {
          "title": "Offset Y",
          "type": "number"
        },
        "css_width": {
          "exclusiveMinimum": 0,
          "title": "Css Width",
          "type": "number"
        },
        "css_height": {
          "exclusiveMinimum": 0,
          "title": "Css Height",
          "type": "number"
        },
        "pixel_width": {
          "exclusiveMinimum": 0,
          "title": "Pixel Width",
          "type": "integer"
        },
        "pixel_height": {
          "exclusiveMinimum": 0,
          "title": "Pixel Height",
          "type": "integer"
        }
      },
      "required": [
        "offset_x",
        "offset_y",
        "css_width",
        "css_height",
        "pixel_width",
        "pixel_height"
      ],
      "title": "CoordinateSpace",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "screenshot",
            "aria",
            "dom",
            "event",
            "trace",
            "configuration"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Viewport": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "maximum": 3840,
          "minimum": 320,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 2160,
          "minimum": 480,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Viewport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "target_id": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "route": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Route",
      "type": "string"
    },
    "viewport": {
      "$ref": "#/$defs/Viewport"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "semantic_text": {
      "maxLength": 16000,
      "title": "Semantic Text",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "mutation_epoch": {
      "minimum": 0,
      "title": "Mutation Epoch",
      "type": "integer"
    },
    "state_digest": {
      "title": "State Digest",
      "type": "string"
    },
    "semantic_signature": {
      "title": "Semantic Signature",
      "type": "string"
    },
    "focus": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Focus",
      "type": "object"
    },
    "validation": {
      "items": {
        "type": "string"
      },
      "title": "Validation",
      "type": "array"
    },
    "frame_urls": {
      "items": {
        "type": "string"
      },
      "title": "Frame Urls",
      "type": "array"
    },
    "coverage_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Coverage Gaps",
      "type": "array"
    },
    "coordinates": {
      "$ref": "#/$defs/CoordinateSpace"
    },
    "extraction_timing_ms": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Extraction Timing Ms",
      "type": "object"
    }
  },
  "required": [
    "target_id",
    "route",
    "viewport",
    "candidates",
    "semantic_text",
    "document_id",
    "mutation_epoch",
    "state_digest",
    "semantic_signature",
    "focus",
    "validation",
    "frame_urls",
    "coverage_gaps",
    "coordinates",
    "extraction_timing_ms"
  ],
  "title": "BrowserObservation",
  "type": "object"
}
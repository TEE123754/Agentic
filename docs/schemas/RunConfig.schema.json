      "minItems": 1,
      "title": "Personas",
      "type": "array"
    },
    "journeys": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{1,63}$",
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Journeys",
      "type": "array"
    },
    "repetitions": {
      "default": 1,
      "maximum": 5,
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "seed": {
      "default": 42,
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"

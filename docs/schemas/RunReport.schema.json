        "inconclusive_agent_failure",
        "blocked_environment",
        "blocked_protection",
        "paused_quota",
        "timed_out",
        "cancelled",
        "interrupted"
      ],
      "title": "SessionOutcome",
      "type": "string"
    },
    "StepResult": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "title": "Action Id",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/Action"
            },
            {
              "type": "null"
            }
          ],

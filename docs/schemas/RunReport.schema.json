          "title": "Boundary Scope",
          "type": "string"
        },
        "traffic_metrics": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Traffic Metrics",
          "type": "object"
        },
        "sentinel_requests": {
          "anyOf": [
            {
              "minimum": 0,

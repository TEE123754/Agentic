            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentinel Requests"
        },
        "sentinel_data_unchanged": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentinel Data Unchanged"
        }
      },
      "required": [
        "events",
        "cleanup_outcome"
      ],
      "title": "ProtectionSummary",
      "type": "object"
    },
    "ReportScope": {
      "additionalProperties": false,

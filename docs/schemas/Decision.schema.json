{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "click",
            "type_text",
            "press_key",
            "scroll",
            "wait",
            "finish"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observation_id": {
          "format": "uuid",
          "title": "Observation Id",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "text_reference": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Reference"
        },
        "key": {
          "anyOf": [
            {
              "enum": [
                "Tab",
                "Shift+Tab",
                "Enter",
                "Space",
                "Escape",
                "ArrowUp",
                "ArrowDown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "amount": {
          "anyOf": [
            {
              "maximum": 800,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "timeout_ms": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Ms"
        }
      },
      "required": [
        "kind",
        "observation_id"
      ],
      "title": "Action",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/Action"
    },
    "rationale": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "action",
    "rationale"
  ],
  "title": "Decision",
  "type": "object"
}
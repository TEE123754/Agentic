        "type": "string"
      },
      "title": "Prohibited Operations",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "goal",
    "completion",
    "prohibited_operations"
  ],
  "title": "Journey",
  "type": "object"
}